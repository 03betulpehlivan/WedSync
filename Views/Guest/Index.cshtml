@model IEnumerable<dugunsalonu.Models.GuestEntry>

@{
    Layout = null;
    var weddingEvent = ViewBag.Event as dugunsalonu.Models.WeddingEvent;
    var isStorageExpired = ViewBag.IsStorageExpired as bool? ?? false;
    var storageEndDate = ViewBag.StorageEndDate as DateTime?;
    var photoCount = Model.Count(e => e.PhotoPath != null && (e.PhotoPath.EndsWith(".jpg") || e.PhotoPath.EndsWith(".png") || e.PhotoPath.EndsWith(".jpeg")));
    var videoCount = Model.Count(e => e.PhotoPath != null && (e.PhotoPath.EndsWith(".mp4") || e.PhotoPath.EndsWith(".mov")));
    var messageCount = Model.Count(e => !string.IsNullOrEmpty(e.Message));
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@weddingEvent?.CoupleName - Dijital Albüm</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    
    <style>
        :root {
            --primary: #6366f1;
            --primary-light: #818cf8;
            --accent: #f43f5e;
            --bg-soft: #f8fafc;
            --card-bg: #ffffff;
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --shadow-sm: 0 4px 6px -1px rgb(0 0 0 / 0.1);
            --shadow-md: 0 10px 15px -3px rgb(0 0 0 / 0.1);
            --radius: 20px;
            --radius-lg: 32px;
        }

        * { box-sizing: border-box; }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f8fafc;
            background-image: 
                radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.05) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(244, 63, 94, 0.05) 0px, transparent 50%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            color: var(--text-dark);
            margin: 0;
        }

        .navbar-custom {
            padding: 1.25rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(10px);
            position: sticky;
            top: 0;
            z-index: 1000;
            border-bottom: 1px solid rgba(0,0,0,0.05);
        }

        .brand-logo {
            font-weight: 800;
            font-size: 1.25rem;
            color: var(--primary);
            text-decoration: none;
            letter-spacing: -0.02em;
        }

        .hero-section {
            padding: 4rem 1rem 2rem;
            text-align: center;
            max-width: 800px;
            margin: 0 auto;
        }

        .couple-names {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2.5rem, 8vw, 4.5rem);
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 0.5rem;
            font-style: italic;
        }

        .wedding-date {
            font-size: 1.1rem;
            color: var(--text-muted);
            font-weight: 500;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            margin-bottom: 2rem;
        }

        .btn-upload {
            background: var(--primary);
            color: white;
            padding: 1rem 2.5rem;
            border-radius: 100px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.75rem;
            box-shadow: 0 10px 15px -3px rgba(99, 102, 241, 0.3);
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            border: 2px solid transparent;
        }

        .btn-upload:hover {
            transform: translateY(-2px);
            box-shadow: 0 20px 25px -5px rgba(99, 102, 241, 0.4);
            background: #4f46e5;
            color: white;
        }

        .filter-nav {
            display: flex;
            gap: 0.5rem;
            justify-content: center;
            margin: 2.5rem 0;
            padding: 0.5rem;
            background: white;
            border-radius: 100px;
            box-shadow: var(--shadow-sm);
            width: fit-content;
            margin-left: auto;
            margin-right: auto;
        }

        .filter-btn {
            border: none;
            background: transparent;
            padding: 0.75rem 1.5rem;
            border-radius: 100px;
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--text-muted);
            transition: all 0.2s;
        }

        .filter-btn.active {
            background: var(--primary);
            color: white;
        }

        .gallery-container {
            width: 100%;
            max-width: 1400px;
            margin: 0 auto;
            padding: 0 1.5rem 4rem;
        }

        .gallery-grid {
            columns: 4 280px;
            column-gap: 1.5rem;
        }

        .gallery-item {
            break-inside: avoid;
            margin-bottom: 1.5rem;
            border-radius: var(--radius);
            overflow: hidden;
            background: white;
            box-shadow: var(--shadow-sm);
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            position: relative;
        }

        .gallery-item:hover {
            transform: scale(1.02);
            box-shadow: var(--shadow-md);
        }

        .gallery-item img, 
        .gallery-item video {
            width: 100%;
            display: block;
            object-fit: cover;
        }

        .message-card {
            padding: 2rem;
            background: linear-gradient(135deg, #6366f1 0%, #818cf8 100%);
            color: white;
        }

        .msg-text {
            font-size: 1.1rem;
            line-height: 1.6;
            margin-bottom: 1.5rem;
            font-weight: 500;
        }

        .msg-author {
            font-size: 0.9rem;
            opacity: 0.9;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }

        .empty-state {
            grid-column: 1 / -1;
            padding: 6rem 2rem;
            text-align: center;
        }

        .empty-state i {
            font-size: 5rem;
            color: var(--primary);
            opacity: 0.2;
            margin-bottom: 1.5rem;
        }


        /* Lightbox */
        .lightbox {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(0,0,0,0.92);
            z-index: 9999;
            align-items: center;
            justify-content: center;
            padding: 20px;
            cursor: pointer;
        }
        .lightbox.active {
            display: flex;
        }
        .lightbox-content {
            max-width: 95vw;
            max-height: 95vh;
            object-fit: contain;
            cursor: default;
        }
        .lightbox-content img,
        .lightbox-content video {
            max-width: 95vw;
            max-height: 90vh;
            object-fit: contain;
            border-radius: 12px;
        }
        .lightbox-close {
            position: fixed;
            top: 20px;
            right: 24px;
            width: 44px;
            height: 44px;
            background: rgba(255,255,255,0.15);
            border: none;
            border-radius: 12px;
            color: white;
            font-size: 1.5rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10000;
            transition: background 0.2s;
        }
        .lightbox-close:hover {
            background: rgba(255,255,255,0.25);
        }
        .lightbox-msg {
            background: linear-gradient(145deg, var(--primary) 0%, #5b4a8f 100%);
            padding: 2rem;
            border-radius: 20px;
            max-width: 400px;
            color: white;
            text-align: left;
        }
        .lightbox-msg .msg-text { font-size: 1.1rem; line-height: 1.6; }
        .lightbox-msg .msg-author { font-size: 0.9rem; opacity: 0.8; margin-top: 1rem; }
        .gallery-item { cursor: pointer; }

        .lightbox-nav {
            position: fixed;
            top: 50%;
            transform: translateY(-50%);
            width: 56px;
            height: 56px;
            background: rgba(255,255,255,0.15);
            border: none;
            border-radius: 50%;
            color: white;
            font-size: 1.5rem;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 10001;
            transition: all 0.2s;
        }
        .lightbox-nav:hover { background: rgba(255,255,255,0.28); }
        .lightbox-nav:disabled { opacity: 0.3; cursor: not-allowed; pointer-events: none; }
        .lightbox-prev { left: 20px; }
        .lightbox-next { right: 20px; }
        .lightbox-counter {
            position: fixed;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            color: rgba(255,255,255,0.85);
            font-size: 0.95rem;
            font-weight: 500;
            z-index: 10001;
        }
    </style>
</head>
<body>

    <div class="navbar-custom">
        <a href="/" class="brand-logo">KarWedding</a>
        <div class="d-flex align-items-center gap-3">
            <a href="#" class="lang-select">TR <i class="bi bi-chevron-down small"></i></a>
        </div>
    </div>

    <div class="hero-section">
        <div class="couple-names">@weddingEvent?.CoupleName</div>
        <div class="wedding-date">Dijital Albüm</div>
        
        @if (!isStorageExpired)
        {
            <a href="/event/@weddingEvent?.Slug/upload" class="btn-upload">
                <i class="bi bi-camera-fill"></i> Anı Paylaş
            </a>
        }
    </div>

    <div class="gallery-container">
        @if (!isStorageExpired)
        {
            <div class="filter-nav">
                <button class="filter-btn active" data-filter="all">Hepsi</button>
                <button class="filter-btn" data-filter="photo">Fotoğraflar</button>
                <button class="filter-btn" data-filter="video">Videolar</button>
                <button class="filter-btn" data-filter="message">Mesajlar</button>
            </div>
        }

        @if (Model.Any())
        {
            <div class="gallery-grid" id="galleryGrid">
                @foreach(var item in Model)
                {
                    @if (!string.IsNullOrEmpty(item.PhotoPath))
                    {
                        var isVideo = item.PhotoPath.EndsWith(".mp4") || item.PhotoPath.EndsWith(".mov");
                        <div class="gallery-item" data-type="@(isVideo ? "video" : "photo")" data-src="@item.PhotoPath" data-lightbox>
                            @if (isVideo)
                            {
                                <video src="@item.PhotoPath" muted playsinline></video>
                            }
                            else
                            {
                                <img src="@item.PhotoPath" alt="Guest Photo" loading="lazy">
                            }
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(item.Message))
                    {
                        <div class="gallery-item message-card" data-type="message" data-message="@item.Message" data-author="@(item.GuestName ?? "Misafir")" data-lightbox>
                            <div class="msg-text">"@item.Message"</div>
                            <div class="msg-author">— @(item.GuestName ?? "Misafir")</div>
                        </div>
                    }
                }
            </div>
        }
        else if (isStorageExpired)
        {
            <div class="empty-state">
                <i class="bi bi-clock-history"></i>
                <h3 class="fw-bold">Depolama süresi dolmuştur</h3>
                <p class="text-muted">Bu etkinliğin içerikleri artık görüntülenememektedir.</p>
                @if (storageEndDate.HasValue)
                {
                    <span class="badge bg-light text-dark">Son tarih: @storageEndDate.Value.ToString("dd.MM.yyyy")</span>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-images"></i>
                <h3 class="fw-bold">Henüz anı paylaşılmamış</h3>
                <p class="text-muted">İlk fotoğrafı veya mesajı sen yükleyerek albümü başlat!</p>
                <a href="/event/@weddingEvent?.Slug/upload" class="btn btn-primary rounded-pill px-4 mt-3">Hemen Yükle</a>
            </div>
        }
    </div>

    <!-- Lightbox -->
    <div class="lightbox" id="lightbox">
        <button class="lightbox-close" id="lightboxClose" aria-label="Kapat"><i class="bi bi-x-lg"></i></button>
        <button class="lightbox-nav lightbox-prev" id="lightboxPrev" aria-label="Önceki"><i class="bi bi-chevron-left"></i></button>
        <div class="lightbox-content" id="lightboxContent"></div>
        <button class="lightbox-nav lightbox-next" id="lightboxNext" aria-label="Sonraki"><i class="bi bi-chevron-right"></i></button>
        <div class="lightbox-counter" id="lightboxCounter"></div>
    </div>

    <script>
        document.querySelectorAll('.filter-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.filter-btn').forEach(function(b) { b.classList.remove('active'); });
                this.classList.add('active');
                var filter = this.getAttribute('data-filter');
                var grid = document.getElementById('galleryGrid');
                if (grid) {
                    grid.querySelectorAll('[data-type]').forEach(function(el) {
                        var type = el.getAttribute('data-type');
                        el.style.display = (filter === 'all' || type === filter) ? '' : 'none';
                    });
                }
            });
        });

        var lightbox = document.getElementById('lightbox');
        var lightboxContent = document.getElementById('lightboxContent');
        var lightboxVideo = null;
        var galleryItems = [];
        var currentIndex = 0;

        function getVisibleItems() {
            var grid = document.getElementById('galleryGrid');
            if (!grid) return [];
            return [].slice.call(grid.querySelectorAll('[data-lightbox]')).filter(function(el) { return el.style.display !== 'none'; });
        }

        function showItem(index) {
            if (index < 0 || index >= galleryItems.length) return;
            currentIndex = index;
            var el = galleryItems[currentIndex];
            lightboxContent.innerHTML = '';
            if (lightboxVideo) { lightboxVideo.pause(); lightboxVideo = null; }
            var type = el.getAttribute('data-type');
            if (type === 'photo') {
                lightboxContent.innerHTML = '<img src="' + el.getAttribute('data-src') + '" alt="Fotoğraf">';
            } else if (type === 'video') {
                lightboxVideo = document.createElement('video');
                lightboxVideo.src = el.getAttribute('data-src');
                lightboxVideo.controls = true;
                lightboxVideo.autoplay = true;
                lightboxVideo.style.width = '100%';
                lightboxVideo.style.maxHeight = '90vh';
                lightboxContent.appendChild(lightboxVideo);
            } else if (type === 'message') {
                var msgDiv = document.createElement('div');
                msgDiv.className = 'lightbox-msg';
                msgDiv.innerHTML = '<div class="msg-text"></div><div class="msg-author"></div>';
                msgDiv.querySelector('.msg-text').textContent = el.getAttribute('data-message') || '';
                msgDiv.querySelector('.msg-author').textContent = '— ' + (el.getAttribute('data-author') || 'Misafir');
                lightboxContent.appendChild(msgDiv);
            }
            document.getElementById('lightboxPrev').disabled = index <= 0;
            document.getElementById('lightboxNext').disabled = index >= galleryItems.length - 1;
            document.getElementById('lightboxCounter').textContent = (index + 1) + ' / ' + galleryItems.length;
        }

        function openLightbox(el) {
            galleryItems = getVisibleItems();
            var idx = galleryItems.indexOf(el);
            currentIndex = idx >= 0 ? idx : 0;
            showItem(currentIndex);
            lightbox.classList.add('active');
            document.body.style.overflow = 'hidden';
        }

        function closeLightbox() {
            lightbox.classList.remove('active');
            document.body.style.overflow = '';
            if (lightboxVideo) { lightboxVideo.pause(); lightboxVideo = null; }
        }

        function goPrev() { if (currentIndex > 0) showItem(currentIndex - 1); }
        function goNext() { if (currentIndex < galleryItems.length - 1) showItem(currentIndex + 1); }

        document.querySelectorAll('[data-lightbox]').forEach(function(el) {
            el.addEventListener('click', function() { openLightbox(el); });
        });
        document.getElementById('lightboxClose').addEventListener('click', function(e) { e.stopPropagation(); closeLightbox(); });
        document.getElementById('lightboxPrev').addEventListener('click', function(e) { e.stopPropagation(); goPrev(); });
        document.getElementById('lightboxNext').addEventListener('click', function(e) { e.stopPropagation(); goNext(); });
        lightbox.addEventListener('click', function(e) { if (e.target === lightbox) closeLightbox(); });
        document.addEventListener('keydown', function(e) {
            if (!lightbox.classList.contains('active')) return;
            if (e.key === 'Escape') closeLightbox();
            if (e.key === 'ArrowLeft') goPrev();
            if (e.key === 'ArrowRight') goNext();
        });

        var touchStartX = 0, touchEndX = 0;
        lightbox.addEventListener('touchstart', function(e) { touchStartX = e.changedTouches[0].screenX; }, { passive: true });
        lightbox.addEventListener('touchend', function(e) {
            touchEndX = e.changedTouches[0].screenX;
            var diff = touchStartX - touchEndX;
            if (Math.abs(diff) > 50) { if (diff > 0) goNext(); else goPrev(); }
        }, { passive: true });
    </script>
</body>
</html>
